#!/bin/bash
# ffdt — the delivery command set for the FFmpeg ARVO dataset.
#
#   ffdt build [DIR]              plain build of a tree (default /src/ffmpeg)
#   ffdt verify [--report DIR] [--tree DIR]
#                                 every PoC on one tree; every one must crash
#                                 -> reports/verify.json, pass=0 for all entries
#   ffdt verify-one <pocId> [--patched] [--report DIR] [--tree DIR] [--keep]
#                                 that one PoC on a tree; must crash, or with
#                                 --patched must come back clean
#                                 -> reports/verify-one.json
#
# `pass` means the PoC did not crash the tree under test, in every report.
# The full attribution run is verify-one-by-one.sh.
set -uo pipefail
. "$(dirname "$0")/lib.sh"

usage() { sed -n '4,13p' "$0"; }
cmd=${1:-}; if [ $# -gt 0 ]; then shift; fi
case "$cmd" in
  build)      "$FFDT_HOME/build.sh" "${1:-$TREE}" ;;
  verify)     "$FFDT_HOME/verify.sh" "$@" ;;
  verify-one) [ $# -gt 0 ] || { usage; exit 1; }; "$FFDT_HOME/verify-one.sh" "$@" ;;
  -h|--help)  usage ;;
  *)          [ -z "$cmd" ] || echo "error: unknown command '$cmd'" >&2; usage >&2; exit 1 ;;
esac
